{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",

  "name": "coupang-discord-ai",

  "main": "index.js",

  "compatibility_date": "2026-09-08",

  "durable_objects": {
    "bindings": [
      {
        "name": "DISCORD_AI_BOT",
        "class_name": "DiscordAIBot"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DiscordAIBot"
      ]
    }
  ]
}
